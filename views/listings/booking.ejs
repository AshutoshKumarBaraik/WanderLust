<% layout("/layouts/boilerplate.ejs") %>

<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">

            <h3>Book Your Stay</h3>

            <div class="card mb-4">
                <img src="<%= listing.image.url %>"
                    class="card-img-top"
                    style="height: 20rem; object-fit: cover;">

                <div class="card-body">
                    <h4><%= listing.title %></h4>
                    <p><%= listing.location %>, <%= listing.country %></p>
                    <h5>&#8377; <%= listing.price.toLocaleString("en-IN") %> /
                        night</h5>
                </div>
            </div>

            <form
                action="/listings/<%= listing._id %>/book"
                method="POST"
                class="needs-validation"
                novalidate>

                <div class="row">

                    <div class="mb-3 col-md-6">
                        <label for="checkIn" class="form-label">
                            Check In
                        </label>

                        <input
                            type="date"
                            id="checkIn"
                            name="booking[checkIn]"
                            class="form-control"
                            required>

                        <div class="invalid-feedback">
                            Please select a check-in date.
                        </div>
                    </div>

                    <div class="mb-3 col-md-6">
                        <label for="checkOut" class="form-label">
                            Check Out
                        </label>

                        <input
                            type="date"
                            id="checkOut"
                            name="booking[checkOut]"
                            class="form-control"
                            required>

                        <div class="invalid-feedback">
                            Please select a check-out date.
                        </div>
                    </div>

                </div>

                <div class="mb-3">
                    <label for="guests" class="form-label">
                        Number of Guests
                    </label>

                    <input
                        type="number"
                        id="guests"
                        name="booking[guests]"
                        class="form-control"
                        value="1"
                        min="1"
                        required>

                    <div class="invalid-feedback">
                        Please enter number of guests.
                    </div>
                </div>

                <div class="mb-3">
                    <h5>
                        Price Per Night :
                        &#8377; <%= listing.price.toLocaleString("en-IN") %>
                    </h5>
                </div>

                <button class="btn btn-dark">
                    Confirm Booking
                </button>

            </form>

        </div>
    </div>
</body>