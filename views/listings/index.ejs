<% layout("/layouts/boilerplate.ejs") %>
<body>
    <!-- <h3>All Listings</h3> -->
    <!-- <form method="GET" action="/listings/new"><button>Create New
            Listing</button></form> -->

    <style>
        #filters{
            display: flex;
            align-items: center;
            flex-wrap: nowrap;
            overflow-x: auto;
            white-space: nowrap;
            padding: 1rem 0;
            scrollbar-width: none;
        }

        #filters::-webkit-scrollbar{
            display: none;
        }

        .filter{
            flex: 0 0 auto;
            text-align: center;
            margin-right: 2rem;
            opacity: 0.7;
            padding-bottom: 0.2rem;
        }

        .filter:hover{
            opacity: 1;
            cursor: pointer;
        }

        .filter p{
            font-size: 0.8rem;
            margin-top: 0.5rem;
        }

        /* CHANGE HERE: Style link tags for filter buttons */
        .filter-link {
            text-decoration: none;
            color: inherit;
        }

        /* CHANGE HERE: Active class highlight for selected filter */
        .filter.active-filter {
            opacity: 1;
            border-bottom: 2px solid black;
        }

        .tax-info{
            display: none;
        }

        .tax-toggle{
            flex: 0 0 auto;
            border: 1px solid black;
            border-radius: 1rem;
            height: 3.25rem;
            padding: 0 1rem;
            margin-left: auto;
            display: flex;
            align-items: center;
            white-space: nowrap;
        }
    </style>

    <div id="filters">
        <!-- ADDED/DESELECT TOGGLE LOGIC HERE: If selectedCategory is 'Trending', clicking sets href to '/listings' (deselects filter). Otherwise sets to '/listings?category=Trending' -->
        <a
            href="<%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Trending') ? '/listings' : '/listings?category=Trending' %>"
            class="filter-link">
            <div
                class="filter <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Trending') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>
        </a>

        <!-- ADDED/DESELECT TOGGLE LOGIC HERE: Toggle back to '/listings' if 'Rooms' is already active -->
        <a
            href="<%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Rooms') ? '/listings' : '/listings?category=Rooms' %>"
            class="filter-link">
            <div
                class="filter <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Rooms') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </div>
        </a>

        <!-- ADDED/DESELECT TOGGLE LOGIC HERE: Toggle back to '/listings' if 'Iconic Cities' is already active -->
        <a
            href="<%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Iconic Cities') ? '/listings' : '/listings?category=Iconic%20Cities' %>"
            class="filter-link">
            <div
                class="filter <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Iconic Cities') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <p>Iconic Cities</p>
            </div>
        </a>

        <!-- ADDED/DESELECT TOGGLE LOGIC HERE: Toggle back to '/listings' if 'Mountains' is already active -->
        <a
            href="<%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Mountains') ? '/listings' : '/listings?category=Mountains' %>"
            class="filter-link">
            <div
                class="filter <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Mountains') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </div>
        </a>

        <!-- ADDED/DESELECT TOGGLE LOGIC HERE: Toggle back to '/listings' if 'Castles' is already active -->
        <a
            href="<%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Castles') ? '/listings' : '/listings?category=Castles' %>"
            class="filter-link">
            <div
                class="filter <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Castles') ? 'active-filter' : '' %>">
                <div><i class="fa-brands fa-fort-awesome"></i></div>
                <p>Castles</p>
            </div>
        </a>

        <!-- ADDED/DESELECT TOGGLE LOGIC HERE: Toggle back to '/listings' if 'Amazing Pools' is already active -->
        <a
            href="<%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Amazing Pools') ? '/listings' : '/listings?category=Amazing%20Pools' %>"
            class="filter-link">
            <div
                class="filter <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Amazing Pools') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-person-swimming"></i></div>
                <p>Amazing Pools</p>
            </div>
        </a>

        <!-- ADDED/DESELECT TOGGLE LOGIC HERE: Toggle back to '/listings' if 'Camping' is already active -->
        <a
            href="<%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Camping') ? '/listings' : '/listings?category=Camping' %>"
            class="filter-link">
            <div
                class="filter <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Camping') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </div>
        </a>

        <!-- ADDED/DESELECT TOGGLE LOGIC HERE: Toggle back to '/listings' if 'Farms' is already active -->
        <a
            href="<%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Farms') ? '/listings' : '/listings?category=Farms' %>"
            class="filter-link">
            <div
                class="filter <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Farms') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-cow"></i></div>
                <p>Farms</p>
            </div>
        </a>

        <!-- ADDED/DESELECT TOGGLE LOGIC HERE: Toggle back to '/listings' if 'Arctic' is already active -->
        <a
            href="<%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Arctic') ? '/listings' : '/listings?category=Arctic' %>"
            class="filter-link">
            <div
                class="filter <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Arctic') ? 'active-filter' : '' %>">
                <div><i class="fa-regular fa-snowflake"></i></div>
                <p>Arctic</p>
            </div>
        </a>

        <!-- ADDED/DESELECT TOGGLE LOGIC HERE: Toggle back to '/listings' if 'Domes' is already active -->
        <a
            href="<%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Domes') ? '/listings' : '/listings?category=Domes' %>"
            class="filter-link">
            <div
                class="filter <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Domes') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-igloo"></i></div>
                <p>Domes</p>
            </div>
        </a>

        <!-- ADDED/DESELECT TOGGLE LOGIC HERE: Toggle back to '/listings' if 'Boats' is already active -->
        <a
            href="<%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Boats') ? '/listings' : '/listings?category=Boats' %>"
            class="filter-link">
            <div
                class="filter <%= (typeof selectedCategory !== 'undefined' && selectedCategory === 'Boats') ? 'active-filter' : '' %>">
                <div><i class="fa-solid fa-ship"></i></div>
                <p>Boats</p>
            </div>
        </a>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch"
                    id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display
                    total after Taxes</label>
            </div>
        </div>

    </div>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(let listing of allListings){ %>
        <a href="/listings/<%= listing._id %>" class="listing-link">

            <div class="card col listing-card">
                <img src="<%= listing.image.url %>" class="card-img-top"
                    alt="listing -image" style="height: 20rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text"><b><%= listing.title %></b><br>
                        <!-- CHANGE HERE: Wrapped price in span with class "price-display" and data-base-price attribute -->
                        <span class="price-display"
                            data-base-price="<%= listing.price %>">
                            &#8377; <%= listing.price ?
                            listing.price.toLocaleString("en-IN") : 0 %>
                        </span> / night
                        <i class="tax-info"> &nbsp; &nbsp; (+18% GST) </i>
                    </p>
                </div>
            </div>
        </a>
        <% } %>
    </div>

</body>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");

    taxSwitch.addEventListener("click", () => {
        // CHANGE HERE: Selecting price elements by class instead of tax-info to update amount
        let priceElements = document.getElementsByClassName("price-display");
        let taxInfoElements = document.getElementsByClassName("tax-info");

        for (let i = 0; i < priceElements.length; i++) {
            // CHANGE HERE: Reading raw base price stored in data-base-price
            let basePrice = parseFloat(priceElements[i].getAttribute("data-base-price")) || 0;

            if (taxSwitch.checked) {
                // CHANGE HERE: Calculating 18% GST addition (basePrice * 1.18)
                let priceWithTax = Math.round(basePrice * 1.18);
                priceElements[i].innerHTML = `&#8377; ${priceWithTax.toLocaleString("en-IN")}`;
                taxInfoElements[i].style.display = "inline";
            } else {
                // CHANGE HERE: Resetting back to original base price
                priceElements[i].innerHTML = `&#8377; ${basePrice.toLocaleString("en-IN")}`;
                taxInfoElements[i].style.display = "none";
            }
        }
    });
</script>