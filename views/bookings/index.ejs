<% layout("/layouts/boilerplate.ejs") %>

<body>

    <h3 class="mt-3 mb-4">My Bookings</h3>

    <% if(bookings.length === 0){ %>

    <h5>You have not booked any property yet.</h5>

    <% } else { %>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">

        <% for(let booking of bookings){ %>

        <div class="card col listing-card mb-4">

            <img
                src="<%= booking.listing.image.url %>"
                class="card-img-top"
                style="height:20rem; object-fit:cover;">

            <div class="card-body">

                <h5 class="card-title">
                    <%= booking.listing.title %>
                </h5>

                <p class="card-text">
                    <%= booking.listing.location %>,
                    <%= booking.listing.country %>
                </p>

                <p class="card-text">
                    <b>Check In:</b>
                    <%= booking.checkIn.toDateString() %>
                </p>

                <p class="card-text">
                    <b>Check Out:</b>
                    <%= booking.checkOut.toDateString() %>
                </p>

                <p class="card-text">
                    <b>Guests:</b>
                    <%= booking.guests %>
                </p>

                <p class="card-text">
                    <b>Total Price:</b>
                    ₹ <%= (booking.totalPrice || 0).toLocaleString("en-IN") %>
                </p>

                <p class="card-text">
                    <b>Status:</b>

                    <% if(booking.status === "Upcoming"){ %>
                    <span class="badge bg-primary">
                        Upcoming
                    </span>
                    <% } %>

                    <% if(booking.status === "Ongoing"){ %>
                    <span class="badge bg-success">
                        Ongoing
                    </span>
                    <% } %>

                    <% if(booking.status === "Completed"){ %>
                    <span class="badge bg-secondary">
                        Completed
                    </span>
                    <% } %>

                    <% if(booking.status === "Cancelled"){ %>
                    <span class="badge bg-danger">
                        Cancelled
                    </span>
                    <% } %>

                </p>

                <div class="d-flex gap-2 mt-3">

                    <a
                        href="/listings/<%= booking.listing._id %>"
                        class="btn btn-dark flex-fill">
                        View Property
                    </a>

                    <% if(booking.status === "Cancelled"){ %>

                    <button
                        class="btn btn-secondary flex-fill"
                        disabled>
                        Booking Cancelled
                    </button>

                    <% } else if(booking.status === "Completed"){ %>

                    <button
                        class="btn btn-secondary flex-fill"
                        disabled>
                        Completed
                    </button>

                    <% } else { %>

                    <form
                        action="/bookings/<%= booking._id %>?_method=PATCH"
                        method="POST"
                        class="flex-fill">

                        <button class="btn btn-danger w-100">
                            Cancel Booking
                        </button>

                    </form>

                    <% } %>

                </div>

            </div>

        </div>

        <% } %>

    </div>

    <% } %>

</body>